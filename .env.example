# --- DJZS gate (x402 payer on Base mainnet) ---
# Base-mainnet EOA private key that pays the 2.00 USDC audit fee.
# Fund this address with >= 2.00 USDC on Base. The x402 facilitator pays gas
# (EIP-3009), so no ETH is needed for the audit itself.
EVM_PRIVATE_KEY=0x...

# Optional: the agent's wallet address, written to the on-chain DJZS trust loop.
# Leave blank to skip the on-chain trust write.
DJZS_AGENT_ADDRESS=

# Optional overrides:
# DJZS_MCP_ENDPOINT=https://mcp.djzs.ai/mcp
# DJZS_MAX_PAYMENT_USDC=2.00

# --- Polymarket CLOB (the trading wallet) ---
# This is the wallet that actually places the Polymarket order.
# Export from https://reveal.magic.link/polymarket (email login) or your web3 wallet.
POLYMARKET_PRIVATE_KEY=0x...
# Your Polymarket profile address (where USDC lives). Required for signatureType 1.
POLYMARKET_FUNDER=0x...
# 0 = browser wallet, 1 = Magic/email login
POLYMARKET_SIGNATURE_TYPE=1

# --- Example trade (edit before running `npm run example`) ---
EXAMPLE_TOKEN_ID=
EXAMPLE_TICK_SIZE=0.001
EXAMPLE_NEG_RISK=false
EXAMPLE_PRICE=0.01
EXAMPLE_SIZE=5
EXAMPLE_THESIS="..."
